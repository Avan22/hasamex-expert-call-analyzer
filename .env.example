# Copy to .env and fill in. Never commit .env.

# Which provider core/llm.py calls: "anthropic" (Claude, the documented default
# choice) or "gemini" (wired in for a verified live run on Gemini's free tier).
MODEL_PROVIDER=gemini

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5        # or claude-opus-5 for more accuracy

# Google Gemini (free tier, https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_RPM=5                 # client-side pacing; the free tier allows 5 req/min per model

# Optional: parallel model calls when answering the 18 guide questions.
# Defaults: 6 for anthropic, 3 for gemini (free-tier rate limits).
# LLM_MAX_WORKERS=3
